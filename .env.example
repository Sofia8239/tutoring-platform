# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# `.env` is git-ignored; `.env.example` is the committed template.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://tutoring:tutoring@localhost:5432/tutoring?schema=public

# Redis — used by BullMQ from Phase 2 (reminders / queues). Safe to leave as-is locally.
REDIS_URL=redis://localhost:6379

# Auth.js (NextAuth v5)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-32-byte-base64-secret
# Optional; Auth.js infers this from the request in most setups.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Added in later phases — listed here so deploys know what to provision.
# ---------------------------------------------------------------------------

# Phase 2b — Google Calendar (OAuth2, outbound sync of lessons).
# Optional: the integration is feature-flagged on CLIENT_ID + CLIENT_SECRET.
# REDIRECT_URI defaults to ${APP_URL}/api/integrations/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Phase 2c / 8 — reminders. Run the worker: `pnpm worker` (needs Redis).
# Email (Resend) is optional — without a key, reminder emails are logged.
# RESEND_API_KEY=
# EMAIL_FROM="Tutoring Platform <no-reply@example.com>"
# REMINDERS_SCAN_EVERY_MINUTES=10

# Phase 4/5 — AI (task generation + homework review). Provider is pluggable.
# AI_PROVIDER picks the adapter; the feature turns on only when that provider's
# key is set. Default: gemini (free tier friendly).
# AI_PROVIDER=gemini            # gemini | claude | openai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Phase 5 — Cloudflare R2 (S3-compatible file storage for homework uploads).
# Optional: uploads fall back to text-only when unset.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=tutoring-uploads

# Whiteboard multiplayer sync — standalone process, run alongside the app:
# `pnpm run whiteboard-sync` (needs DATABASE_URL; not part of `next dev`/`next start`).
# NEXT_PUBLIC_WHITEBOARD_SYNC_URL is the ws(s):// base URL the browser connects to;
# in prod this is your reverse proxy's path to the sync process, not the raw port.
NEXT_PUBLIC_WHITEBOARD_SYNC_URL=ws://localhost:8788
WHITEBOARD_SYNC_PORT=8788
# Optional: HMAC secret for room-join tickets. Falls back to AUTH_SECRET if unset.
# WHITEBOARD_SYNC_SECRET=

# Phase 7 — Payments (single PaymentProvider interface over both).
# PAYMENT_PROVIDER picks the active one; payments stay off until it's set AND
# that provider's own keys are present (no default — unlike AI, moves real money).
# PAYMENT_PROVIDER=liqpay        # liqpay | monobank
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# MONOBANK_ACQUIRING_TOKEN=
# Only needed if APP_URL isn't publicly reachable by the provider (e.g. an
# ngrok tunnel during local dev — LiqPay/Monobank can't POST to localhost).
# PAYMENTS_WEBHOOK_BASE_URL=https://your-tunnel.example
